---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Solucion from '../components/Solucion.astro';
import StickyCta from '../components/ui/StickyCta.astro';
import site from '../content/site.json';
---

<Base title={site.meta.title} description={site.meta.description}>
  <Header header={site.header} whatsapp={site.whatsapp} />
  <main>
    <Hero hero={site.hero} whatsapp={site.whatsapp} casos={site.casos} />
    {site.problema && <Problema problema={site.problema} />}
    {site.mecanismos && <Solucion mecanismos={site.mecanismos} />}
  </main>
  <StickyCta whatsapp={site.whatsapp} />
</Base>
