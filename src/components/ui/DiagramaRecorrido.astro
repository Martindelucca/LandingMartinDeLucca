---
interface Props {
  estado: string;
  canales: Array<{ nombre: string; pregunta: string }>;
  convergencia: string;
  pregunta: string;
  aspectos: string;
}

const { estado, canales, convergencia, pregunta, aspectos } = Astro.props;
---

<div class="diagram-panel">
  <p class="diagram-state">{estado}</p>

  <ol class="sources" aria-label={estado}>
    {canales.map((canal) => (
      <li class="source">
        <span class="source-name">{canal.nombre}</span>
        <span class="source-question">{canal.pregunta}</span>
      </li>
    ))}
  </ol>

  <div class="connector" aria-hidden="true">
    <span class="stem"></span>
    <span class="stem"></span>
    <span class="stem"></span>
  </div>

  <div class="destination">
    <p class="destination-converge">{convergencia}</p>
    <p class="destination-question">{pregunta}</p>
    <p class="destination-aspects">{aspectos}</p>
  </div>
</div>

<style>
  .diagram-panel {
    min-width: 0;
    text-align: center;
  }

  .diagram-state,
  .source-name,
  .source-question,
  .destination-aspects {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .diagram-state {
    border-bottom: 1px solid var(--rule);
    color: var(--text);
    font-size: 12px;
    margin: 0 0 var(--sp-8);
    padding-bottom: var(--sp-5);
  }

  /*
    Tres orígenes, un destino. La topología es lo que la separa del diagrama
    de Recorrido: allá es una cadena lineal de cinco nodos iguales sobre --ink;
    acá es una convergencia de tres en uno sobre --panel. Distinta forma,
    distinto fondo, distinta lectura (D-25).
  */
  .sources {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .source {
    align-items: center;
    background: var(--paper);
    border: 1px solid var(--rule-hard);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    justify-content: center;
    min-height: var(--sp-12);
    min-width: 0;
    padding: var(--sp-4) var(--sp-2);
  }

  .source-name {
    color: var(--text-strong);
    font-size: 11px;
  }

  /*
    La pregunta es el mecanismo: ninguna de las tres se puede contestar con
    confianza. Va en minúscula y en --text para quedar subordinada al canal,
    que es lo que se escanea primero.
  */
  .source-question {
    color: var(--text);
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  /*
    Conector en horquilla, no en diagonales: las diagonales quedan bien a un
    ancho fijo y se descuadran en cualquier otro. Tres bajadas, un travesaño
    y una bajada al destino, todo con porcentajes — aguanta cualquier ancho.
  */
  .connector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    height: var(--sp-12);
    position: relative;
  }

  .stem {
    border-left: 1px dashed var(--text);
    height: 50%;
    justify-self: center;
    opacity: 0.55;
  }

  .connector::before {
    border-top: 1px dashed var(--text);
    content: '';
    inset-inline: 16.666%;
    opacity: 0.55;
    position: absolute;
    top: 50%;
  }

  .connector::after {
    border-left: 1px dashed var(--text);
    content: '';
    height: 50%;
    left: 50%;
    opacity: 0.55;
    position: absolute;
    top: 50%;
  }

  .destination {
    background: var(--paper);
    border: 1px solid var(--rule-hard);
    border-radius: var(--radius);
    padding: var(--sp-6) var(--sp-5);
  }

  .destination-converge {
    color: var(--text);
    font-size: 15px;
    line-height: 1.4;
    margin: 0 0 var(--sp-3);
  }

  /* El destino es una pregunta y no una respuesta: ahí es donde falta algo. */
  .destination-question {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  .destination-aspects {
    border-top: 1px solid var(--rule);
    color: var(--text);
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    margin: var(--sp-5) 0 0;
    padding-top: var(--sp-4);
  }

  @media (min-width: 900px) {
    .connector {
      height: var(--sp-16);
    }

    .destination {
      padding: var(--sp-8);
    }
  }
</style>
