---
interface Props {
  estado: string;
  canales: string;
  nodos: string[];
}

const { estado, canales, nodos } = Astro.props;
---

<div class="diagram-panel">
  <p class="diagram-state">{estado}</p>
  <ol class="diagram" aria-label={estado}>
    {nodos.map((nodo, index) => (
      <>
        <li class:list={['diagram-node', index < 2 ? 'diagram-node--firm' : 'diagram-node--fading']}>
          <span class="diagram-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="diagram-text">{nodo}</span>
          {index === 0 && <span class="diagram-channels">{canales}</span>}
        </li>
        {index < nodos.length - 1 && <li class="diagram-arrow" aria-hidden="true">↓</li>}
      </>
    ))}
  </ol>
</div>

<style>
  .diagram-panel {
    min-width: 0;
  }

  .diagram-state {
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin-bottom: var(--sp-6);
    text-transform: uppercase;
  }

  .diagram {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    min-width: 0;
  }

  .diagram-node {
    align-items: center;
    border-radius: var(--radius);
    display: grid;
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 15px;
    font-weight: 600;
    gap: var(--sp-3);
    grid-template-columns: auto minmax(0, 1fr);
    line-height: 1.25;
    min-height: 48px;
    min-width: 0;
    padding: 14px var(--sp-4);
  }

  .diagram-node--firm {
    background: var(--paper);
    border: 1px solid var(--ink);
    color: var(--text-strong);
  }

  .diagram-node--fading {
    border: 1px dashed var(--text);
    color: var(--text);
  }

  .diagram-index,
  .diagram-channels,
  .diagram-arrow {
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .diagram-channels {
    grid-column: 2;
    text-transform: uppercase;
  }

  .diagram-arrow {
    padding-left: var(--sp-4);
  }

  @media (min-width: 900px) {
    .diagram-node {
      width: 100%;
    }

    .diagram-text,
    .diagram-channels {
      white-space: nowrap;
    }
  }
</style>
