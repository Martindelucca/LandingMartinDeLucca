---
import WhatsappButton from './ui/WhatsappButton.astro';
import DiagramaRecorrido from './ui/DiagramaRecorrido.astro';

interface Props {
  hero: {
    eyebrow: string;
    h1: string;
    bajada: string;
    microPrueba: string;
    microPruebaPrefix?: string;
    microPruebaFallback?: string;
    diagrama: {
      estado: string;
      canales: string;
      nodos: string[];
    };
  };
  whatsapp: {
    numero: string;
    etiquetaCta: string;
    microcopy: string;
    mensajes: {
      hero: string;
    };
  };
  casos?: {
    casos?: Array<{
      nombre?: string | null;
      url?: string | null;
    }> | null;
  } | null;
}

const { hero, whatsapp, casos } = Astro.props;
const firstCase = casos?.casos?.[0];
const microProofUrl = firstCase?.url?.trim() ?? '';
const microProofLabel = firstCase?.nombre?.trim() || hero.microPruebaFallback?.trim() || hero.microPrueba.trim();
const microProofPrefix = hero.microPruebaPrefix?.trim() ?? '';
const hasMicroProof = Boolean(microProofUrl && microProofLabel);
const h1Sentences = hero.h1.trim().split(/(?<=\.)\s+/);
const h1FirstSentence = h1Sentences[0] ?? hero.h1;
const h1SecondSentence = h1Sentences.slice(1).join(' ');
const h1Words = h1SecondSentence.split(/\s+/).filter(Boolean);
const h1SecondLead = h1Words.slice(0, 3).join(' ');
const h1SecondTail = h1Words.slice(3).join(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">
      <span>{h1FirstSentence}</span>
      {h1SecondSentence && (
        <>
          <br />
          <span class="h1-second">
            <span>{h1SecondLead}</span>{h1SecondTail && ' '}
            <span class="h1-tail">{h1SecondTail}</span>
          </span>
        </>
      )}
    </h1>
    <p class="hero-lede">{hero.bajada}</p>
    <div class="hero-action">
      <WhatsappButton
        number={whatsapp.numero}
        message={whatsapp.mensajes.hero}
        label={whatsapp.etiquetaCta}
        origin="hero"
      />
      <p class="microcopy">{whatsapp.microcopy}</p>
    </div>
    {hasMicroProof && (
      <p class="micro-proof">
        {microProofPrefix && <span>{microProofPrefix}: </span>}
        <a href={microProofUrl}>{microProofLabel} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
  <div class="hero-diagram">
    <DiagramaRecorrido
      estado={hero.diagrama.estado}
      canales={hero.diagrama.canales}
      nodos={hero.diagrama.nodos}
    />
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--rule-hard);
    display: grid;
    grid-template-columns: 1fr;
  }

  .hero-content {
    border-bottom: 1px solid var(--rule);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
    width: 100%;
  }

  .hero-diagram {
    background-color: var(--panel);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .eyebrow {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin-bottom: var(--sp-6);
    text-transform: uppercase;
  }

  h1 {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .h1-second,
  .h1-tail {
    display: inline;
  }

  .hero-lede {
    font-size: 17px;
    line-height: 1.6;
    margin-top: var(--sp-6);
    max-width: 34rem;
  }

  .hero-action {
    margin-top: var(--sp-6);
  }

  .microcopy,
  .micro-proof {
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .microcopy {
    margin-top: var(--sp-3);
  }

  .micro-proof {
    border-top: 1px solid var(--rule);
    margin: var(--sp-6) 0 0;
    padding-top: var(--sp-3);
  }

  .micro-proof a {
    color: var(--green);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  @media (min-width: 600px) {
    h1 {
      font-size: 44px;
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .hero-content,
    .hero-diagram {
      padding: calc(var(--sp-12) + var(--sp-2)) calc(var(--sp-8) + var(--sp-2));
    }

    .hero-content {
      border-bottom: 0;
      border-right: 1px solid var(--rule);
      max-width: none;
    }

    .hero-diagram {
      background-image: linear-gradient(var(--rule) 1px, transparent 1px),
        linear-gradient(90deg, var(--rule) 1px, transparent 1px);
      background-size: var(--sp-8) var(--sp-8);
    }

    h1 {
      font-size: 50px;
    }

    .h1-tail {
      display: block;
    }

    .hero-action {
      margin-top: var(--sp-8);
    }
  }

  @media (min-width: 1280px) {
    .hero-content,
    .hero-diagram {
      padding-inline: var(--sp-16);
    }
  }
</style>
