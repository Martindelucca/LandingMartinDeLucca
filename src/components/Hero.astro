---
import WhatsappButton from './ui/WhatsappButton.astro';
import DiagramaRecorrido from './ui/DiagramaRecorrido.astro';

interface Props {
  hero: {
    eyebrow: string;
    h1: string;
    bajada: string;
    microPrueba: string;
    microPruebaFallback?: string;
    diagrama: {
      estado: string;
      canales: string;
      nodos: string[];
    };
  };
  whatsapp: {
    numero: string;
    etiquetaCta: string;
    microcopy: string;
    mensajes: {
      hero: string;
    };
  };
  casos?: {
    casos?: Array<{
      nombre?: string | null;
      url?: string | null;
    }> | null;
  } | null;
}

const { hero, whatsapp, casos } = Astro.props;
const firstCase = casos?.casos?.[0];
const microProofUrl = firstCase?.url?.trim() ?? '';
const microProofLabel = firstCase?.nombre?.trim() || hero.microPruebaFallback?.trim() || hero.microPrueba.trim();
const hasMicroProof = Boolean(microProofUrl && microProofLabel);
const h1Sentences = hero.h1.trim().split(/(?<=\.)\s+/);
const h1FirstSentence = h1Sentences[0] ?? hero.h1;
const h1SecondSentence = h1Sentences.slice(1).join(' ');
const h1Words = h1SecondSentence.split(/\s+/).filter(Boolean);
const h1Tail = h1Words.slice(-3).join(' ');
const h1Lead = h1Words.slice(0, -3).join(' ');
---

<section class:list={['hero', { 'has-micro-proof': hasMicroProof }]} aria-labelledby="hero-title">
    <div class="hero-content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">
        <span>{h1FirstSentence}</span>
        {h1SecondSentence && (
          <>
            <br />
            <span>
              {h1Lead}{h1Lead && ' '}
              <span class="nowrap">{h1Tail}</span>
            </span>
          </>
        )}
      </h1>
      <p class="hero-lede">{hero.bajada}</p>
      <div class="hero-action">
        <WhatsappButton
          number={whatsapp.numero}
          message={whatsapp.mensajes.hero}
          label={whatsapp.etiquetaCta}
          origin="hero"
        />
        <p class="microcopy">{whatsapp.microcopy}</p>
      </div>
      {hasMicroProof && (
        <p class="micro-proof">
          <a href={microProofUrl}>{microProofLabel} <span aria-hidden="true">→</span></a>
        </p>
      )}
    </div>
    <div class="hero-diagram">
      <DiagramaRecorrido
        estado={hero.diagrama.estado}
        canales={hero.diagrama.canales}
        nodos={hero.diagrama.nodos}
      />
    </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--sp-6);
    margin-inline: auto;
    max-width: 1120px;
    padding-block: var(--sp-24);
    padding-inline: var(--sp-5);
  }

  .hero-content {
    max-width: 34rem;
  }

  .eyebrow {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.2;
    margin-bottom: var(--sp-4);
    text-transform: uppercase;
  }

  h1 {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: clamp(34px, 8vw, 40px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.06;
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero-lede {
    font-size: 19px;
    line-height: 1.5;
    margin-top: var(--sp-4);
    max-width: 34rem;
  }

  @media (min-width: 900px) {
    .hero-lede {
      font-size: 22px;
    }

    .eyebrow {
      font-size: 13px;
    }
  }

  .hero-action {
    margin-top: var(--sp-6);
  }

  .microcopy {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.5;
    margin-top: var(--sp-3);
  }

  .micro-proof {
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.5;
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
  }

  .micro-proof a {
    color: var(--green);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  @media (min-width: 600px) {
    h1 {
      font-size: 48px;
    }
  }

  @media (min-width: 900px) {
    :global(html),
    :global(body) {
      overflow-x: clip;
    }

    .hero {
      --hero-bleed: calc((100vw - min(1120px, 100vw)) / 2 + var(--sp-8));
      align-items: start;
      grid-template-columns: minmax(0, 7fr) minmax(374px, 5fr);
      gap: var(--sp-8);
      padding-block: var(--sp-32);
      padding-inline: var(--sp-8);
    }

    h1 {
      font-size: 56px;
    }

    .hero-diagram {
      align-self: stretch;
      min-width: 0;
      margin-right: calc(var(--hero-bleed) * -1);
      position: relative;
      width: calc(100% + var(--hero-bleed));
    }

    .hero-diagram::before {
      background: var(--rule);
      content: '';
      inset-block: 0;
      left: calc(var(--sp-8) / -2);
      position: absolute;
      width: 1px;
    }

    .hero-diagram :global(.diagram-panel) {
      width: 100%;
    }
  }

</style>
