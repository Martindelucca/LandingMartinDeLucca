---
interface Props {
  numero: string;
  problema: {
    titulo: string;
    citas: string[];
    puente: string;
  };
}

const { numero, problema } = Astro.props;
---

<section class="problema" id="problema" aria-labelledby="problema-title">
  <h2 id="problema-title" class="section-label">{numero} / {problema.titulo}</h2>
  <div class="problem-quotes">
    {problema.citas.map((cita) => <p><span>{cita}</span></p>)}
  </div>
  <p class="problem-bridge">{problema.puente}</p>
</section>

<style>
  .problema {
    border-bottom: 1px solid var(--rule);
    padding: var(--sp-section-y) var(--sp-section-x);
  }

  .section-label {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0 0 var(--sp-section-gap);
    text-transform: uppercase;
  }

  /*
    Sin cajas. Las celdas con filete eran contenedores puros: no cargaban
    argumento y a anchos grandes quedaban medio vacías, con la cita a 17 px
    perdida adentro. Ahora cada voz se separa con un filete superior y pesa
    lo que tiene que pesar — el volumen de voces ES el argumento de la sección.
  */
  .problem-quotes {
    display: grid;
    grid-template-columns: 1fr;
  }

  .problem-quotes p {
    border-top: 1px solid var(--rule-hard);
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    padding: var(--sp-5) 0;
    width: 100%;
  }

  .problem-quotes p span {
    display: block;
    max-width: 40rem;
  }

  /* Enuncia la tesis y es el único puente hacia Recorrido: va a escala de titular. */
  .problem-bridge {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin-top: var(--sp-section-gap);
    max-width: 22ch;
  }

  @media (min-width: 900px) {
    /*
      2×2 en todo el desktop, sin fila de cuatro. En una sola fila las citas
      quedan angostas y la sección se lee como una tira de etiquetas; en cuadro
      se leen como cuatro voces distintas, que es lo que tiene que transmitir.
    */
    .problem-quotes {
      column-gap: var(--sp-16);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .problem-quotes p {
      padding: var(--sp-6) 0;
    }
  }
</style>
