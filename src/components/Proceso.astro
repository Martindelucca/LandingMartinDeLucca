---
interface Props {
  numero: string;
  proceso: {
    titulo: string;
    etiquetas: {
      paso: string;
      quePasa: string;
      deVos: string;
      cuando: string;
    };
    pasos: Array<{
      n: number;
      queePasa: string;
      queNecesito: string;
      cuando: string;
    }>;
    garantia: string;
    soporte: string;
  };
}

const { numero, proceso } = Astro.props;
---

<section class="process-section" id="proceso" aria-labelledby="process-title">
  <h2 id="process-title" class="section-label">{numero} / {proceso.titulo}</h2>
  <table class="process-table" aria-labelledby="process-title">
    <thead>
      <tr>
        <th scope="col" aria-label={proceso.etiquetas.paso}></th>
        <th scope="col">{proceso.etiquetas.quePasa}</th>
        <th scope="col">{proceso.etiquetas.deVos}</th>
        <th scope="col">{proceso.etiquetas.cuando}</th>
      </tr>
    </thead>
    <tbody>
      {proceso.pasos.map((paso) => (
        <tr>
          <td class="step-number">{String(paso.n).padStart(2, '0')}</td>
          <td class="step-title">{paso.queePasa}</td>
          <td>
            <span class="mobile-label">{proceso.etiquetas.deVos}:</span>
            <span>{paso.queNecesito}</span>
          </td>
          <td>
            <span class="mobile-label">{proceso.etiquetas.cuando}:</span>
            <span>{paso.cuando}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="process-closing">
    <span>{proceso.garantia}</span>
    <span>{proceso.soporte}</span>
  </p>
</section>

<style>
  .process-section {
    border-bottom: 1px solid var(--rule);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .section-label,
  th {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-6);
  }

  .process-table {
    border-collapse: collapse;
    table-layout: fixed;
    width: 100%;
  }

  th {
    color: var(--text);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 0 0 var(--sp-3);
    text-align: left;
  }

  th:first-child,
  td:first-child {
    width: 56px;
  }

  th:nth-child(2),
  td:nth-child(2) {
    width: 30%;
  }

  th:nth-child(3),
  td:nth-child(3) {
    width: 42%;
  }

  th:last-child,
  td:last-child {
    width: 110px;
  }

  tbody tr + tr {
    border-top: 1px solid var(--rule);
  }

  td {
    color: var(--text);
    font-size: 17px;
    line-height: 1.6;
    min-width: 0;
    padding: 20px 0;
    vertical-align: top;
  }

  .step-number {
    color: var(--green);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    padding-right: var(--sp-3);
  }

  .step-title {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-weight: 600;
  }

  .mobile-label {
    color: var(--text);
    display: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .process-closing {
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 400;
    gap: var(--sp-2);
    line-height: 1.6;
    margin: var(--sp-8) 0 0;
  }

  @media (min-width: 900px) {
    .process-section {
      padding-block: calc(var(--sp-12) + var(--sp-2));
      padding-inline: calc(var(--sp-8) + var(--sp-2));
    }

    th:first-child,
    td:first-child {
      width: 72px;
    }

    th:last-child,
    td:last-child {
      width: 120px;
    }
  }

  @media (max-width: 899px) {
    .process-table,
    .process-table tbody,
    .process-table tr,
    .process-table td {
      display: block;
    }

    .process-table thead {
      display: none;
    }

    .process-table tr {
      padding: 20px 0;
    }

    .process-table tbody tr + tr {
      border-top: 1px solid var(--rule);
    }

    .process-table td,
    .process-table td:first-child,
    .process-table td:nth-child(2),
    .process-table td:nth-child(3),
    .process-table td:last-child {
      padding: 0;
      width: auto;
    }

    .process-table td + td {
      margin-top: var(--sp-3);
    }

    .step-number {
      display: block;
      margin-bottom: var(--sp-3);
    }

    .mobile-label {
      display: inline;
      margin-right: var(--sp-2);
    }
  }

  @media (min-width: 1280px) {
    .process-section {
      padding-inline: var(--sp-16);
    }
  }
</style>
