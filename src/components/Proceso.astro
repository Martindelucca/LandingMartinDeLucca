---
interface Props {
  numero: string;
  proceso: {
    titulo: string;
    etiquetas: {
      deVos: string;
      cuando: string;
    };
    pasos: Array<{
      n: number;
      queePasa: string;
      queNecesito: string;
      cuando: string;
    }>;
    garantia: string;
    soporte: string;
  };
}

const { numero, proceso } = Astro.props;
---

<section class="process-section" id="proceso" aria-labelledby="process-title">
  <h2 id="process-title" class="section-label">{numero} / {proceso.titulo}</h2>
  <div class="process-grid">
    {proceso.pasos.map((paso) => (
      <article class="process-step">
        <p class="step-number">{String(paso.n).padStart(2, '0')}</p>
        <h3>{paso.queePasa}</h3>
        <dl>
          <div>
            <dt>{proceso.etiquetas.deVos}</dt>
            <dd>{paso.queNecesito}</dd>
          </div>
          <div>
            <dt>{proceso.etiquetas.cuando}</dt>
            <dd>{paso.cuando}</dd>
          </div>
        </dl>
      </article>
    ))}
  </div>
  <p class="process-closing">
    <span>{proceso.garantia}</span>
    <span>{proceso.soporte}</span>
  </p>
</section>

<style>
  .process-section {
    border-bottom: 1px solid var(--rule);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .section-label,
  .step-number,
  dt {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-6);
  }

  .process-grid {
    background: var(--rule);
    border: 1px solid var(--rule);
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
  }

  .process-step {
    background: var(--paper);
    min-width: 0;
    padding: var(--sp-6);
  }

  .step-number {
    margin: 0 0 var(--sp-6);
  }

  h3 {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 var(--sp-6);
  }

  dl {
    display: grid;
    gap: var(--sp-4);
    margin: 0;
  }

  dl > div {
    display: grid;
    gap: var(--sp-2);
  }

  dt {
    color: var(--text);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  dd {
    color: var(--text);
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
  }

  .process-closing {
    color: var(--text-strong);
    display: flex;
    flex-wrap: wrap;
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 20px;
    font-weight: 600;
    gap: var(--sp-2);
    line-height: 1.25;
    margin: var(--sp-8) 0 0;
  }

  @media (min-width: 900px) {
    .process-section {
      padding-block: calc(var(--sp-12) + var(--sp-2));
      padding-inline: calc(var(--sp-8) + var(--sp-2));
    }

    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .process-section {
      padding-inline: var(--sp-16);
    }

    .process-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
