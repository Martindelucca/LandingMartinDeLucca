---
interface Props {
  numero: string;
  proceso: {
    titulo: string;
    etiquetas: {
      paso: string;
      quePasa: string;
      deVos: string;
      cuando: string;
    };
    pasos: Array<{
      n: number;
      queePasa: string;
      detalle?: string;
      queNecesito: string;
      cuando: string;
    }>;
    garantia: string;
    soporte: string;
  };
}

const { numero, proceso } = Astro.props;
---

<section class="process-section" id="proceso" aria-labelledby="process-title">
  <h2 id="process-title" class="section-label">{numero} / {proceso.titulo}</h2>

  <table class="process-table" aria-labelledby="process-title">
    <thead>
      <tr>
        <th scope="col" aria-label={proceso.etiquetas.paso}></th>
        <th scope="col">{proceso.etiquetas.quePasa}</th>
        <th scope="col">{proceso.etiquetas.deVos}</th>
        <th scope="col">{proceso.etiquetas.cuando}</th>
      </tr>
    </thead>
    <tbody>
      {proceso.pasos.map((paso) => (
        <tr>
          <td class="step-number">{String(paso.n).padStart(2, '0')}</td>
          <td class="step-title">
            <span class="step-name">{paso.queePasa}</span>
            {paso.detalle && <span class="step-detail">{paso.detalle}</span>}
          </td>
          <td>{paso.queNecesito}</td>
          <td>{paso.cuando}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <ol class="mobile-rail" aria-label={proceso.titulo}>
    {proceso.pasos.map((paso, index) => (
      <li class="mobile-rail__step" style={`--i: ${index}`}>
        <span class="mobile-rail__when">{paso.cuando}</span>
        <h3 class="mobile-rail__title">{paso.queePasa}</h3>
        {paso.detalle && <p class="mobile-rail__detail">{paso.detalle}</p>}
        <p class="mobile-rail__you">
          <span class="mobile-rail__label">{proceso.etiquetas.deVos}:</span> {paso.queNecesito}
        </p>
      </li>
    ))}
  </ol>

  <p class="process-closing">
    <span>{proceso.garantia}</span>
    <span>{proceso.soporte}</span>
  </p>
</section>

<script>
  const initMobileProcesoRail = () => {
    const rail = document.querySelector<HTMLElement>('#proceso .mobile-rail');

    if (
      !rail ||
      rail.dataset.reveal !== undefined ||
      !('IntersectionObserver' in window) ||
      !('matchMedia' in window)
    ) {
      return;
    }

    rail.dataset.reveal = '';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rail.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          rail.classList.add('is-visible');
          observer.unobserve(rail);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    observer.observe(rail);
  };

  initMobileProcesoRail();
</script>

<style>
  .process-section {
    border-bottom: 1px solid var(--rule);
    padding: var(--sp-section-y) var(--sp-section-x);
  }

  .section-label,
  th {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-section-gap);
  }

  .process-table {
    border-collapse: collapse;
    table-layout: fixed;
    width: 100%;
  }

  th {
    color: var(--text);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 0 0 var(--sp-3);
    text-align: left;
  }

  th:first-child,
  td:first-child {
    width: 56px;
  }

  th:nth-child(2),
  td:nth-child(2) {
    width: 42%;
  }

  th:nth-child(3),
  td:nth-child(3) {
    width: 30%;
  }

  th:last-child,
  td:last-child {
    width: 110px;
  }

  tbody tr + tr {
    border-top: 1px solid var(--rule);
  }

  td {
    color: var(--text);
    font-size: 17px;
    line-height: 1.6;
    min-width: 0;
    padding: 20px 0;
    vertical-align: top;
  }

  .step-number {
    color: var(--green);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    padding-right: var(--sp-3);
  }

  .step-name {
    color: var(--text-strong);
    display: block;
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-weight: 600;
  }

  /*
    La línea que explica el paso. "De vos" y "Cuándo" siguen alineados al tope
    de la fila: la columna "De vos" leída hacia abajo tiene que seguir
    entrándote de un vistazo, que es lo que sostiene la sección (UX_SPEC §06).
  */
  .step-detail {
    color: var(--text);
    display: block;
    font-size: 15px;
    line-height: 1.5;
    margin-top: var(--sp-2);
    max-width: 34rem;
  }

  .mobile-rail {
    display: none;
  }

  .process-closing {
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    gap: var(--sp-2);
    line-height: 1.6;
    margin: var(--sp-8) 0 0;
  }

  @media (min-width: 900px) {
    th:first-child,
    td:first-child {
      width: 72px;
    }

    th:last-child,
    td:last-child {
      width: 120px;
    }
  }

  @media (max-width: 899px) {
    .process-table {
      display: none;
    }

    .mobile-rail {
      display: block;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .mobile-rail__step {
      min-width: 0;
      padding-block-end: var(--sp-12);
      padding-inline-start: var(--sp-8);
      position: relative;
    }

    .mobile-rail__step:last-child {
      padding-block-end: 0;
    }

    .mobile-rail__step::before {
      background: var(--rule-hard);
      bottom: calc(var(--sp-3) - var(--sp-12));
      content: '';
      inline-size: 1px;
      inset-inline-start: var(--sp-2);
      opacity: 0.28;
      position: absolute;
      top: var(--sp-3);
    }

    .mobile-rail__step:last-child::before {
      display: none;
    }

    .mobile-rail__step::after {
      background: var(--green);
      border-radius: var(--radius);
      content: '';
      block-size: var(--sp-4);
      inline-size: var(--sp-4);
      inset-inline-start: 0;
      position: absolute;
      top: var(--sp-2);
    }

    .mobile-rail__when {
      color: var(--green);
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.08em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .mobile-rail__title {
      color: var(--text-strong);
      font-family: 'Archivo Variable', Arial, sans-serif;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin: var(--sp-2) 0;
    }

    .mobile-rail__detail {
      color: var(--text);
      font-size: 15px;
      line-height: 1.5;
      margin: 0 0 var(--sp-3);
      max-width: 40ch;
    }

    .mobile-rail__you {
      color: var(--text);
      font-size: 17px;
      line-height: 1.6;
      margin: 0;
      max-width: 34ch;
    }

    .mobile-rail__label {
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    @media (prefers-reduced-motion: no-preference) {
      .mobile-rail[data-reveal] .mobile-rail__step {
        opacity: 0;
        transform: translateY(var(--sp-3));
      }

      .mobile-rail[data-reveal].is-visible .mobile-rail__step {
        animation: proceso-step-in 400ms ease-out forwards;
        animation-delay: calc(var(--i) * 80ms);
      }

      @keyframes proceso-step-in {
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }

</style>
