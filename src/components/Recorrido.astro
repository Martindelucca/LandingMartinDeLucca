---
interface Props {
  numero: string;
  recorrido: {
    titulo: string;
    fraseInstagram: string;
    diagrama: {
      antesEtiqueta: string;
      despuesEtiqueta: string;
      canales: string;
      antes: string[];
      despues: string[];
    };
    cierre: string;
  };
}

const { numero, recorrido } = Astro.props;
const rows = [
  {
    etiqueta: recorrido.diagrama.antesEtiqueta,
    nodos: recorrido.diagrama.antes,
    estado: 'before',
  },
  {
    etiqueta: recorrido.diagrama.despuesEtiqueta,
    nodos: recorrido.diagrama.despues,
    estado: 'after',
  },
];
---

<section class="recorrido" id="recorrido" aria-labelledby="recorrido-title">
  <p class="section-label">{numero} / {recorrido.titulo}</p>
  <h2 id="recorrido-title">{recorrido.fraseInstagram}</h2>
  <div class="route-comparison">
    {rows.map((row, rowIndex) => (
      <div class:list={['route-row', `route-row--${row.estado}`]}>
        <p class="route-label" id={`route-label-${row.estado}`}>{row.etiqueta}</p>
        <ol class="route-nodes" aria-labelledby={`route-label-${row.estado}`}>
          {row.nodos.map((nodo, index) => (
            <li class="route-node">
              <span class="route-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="route-text">{nodo}</span>
              {rowIndex === 0 && index === 0 && <span class="route-channels">{recorrido.diagrama.canales}</span>}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
  <p class="route-closing">{recorrido.cierre}</p>
</section>

<style>
  .recorrido {
    background: var(--ink);
    border-bottom: 1px solid var(--rule);
    color: var(--text-on-ink);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .section-label,
  .route-label,
  .route-number,
  .route-channels {
    color: var(--green-light);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-6);
  }

  h2 {
    color: var(--text-on-ink);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0;
  }

  .route-comparison {
    margin-top: var(--sp-6);
  }

  .route-row + .route-row {
    margin-top: 0;
  }

  .route-label {
    padding-top: var(--sp-6);
    margin: 0 0 var(--sp-3);
  }

  .route-nodes {
    align-items: start;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .route-node {
    border: 1px dashed var(--text-on-ink-muted);
    border-radius: var(--radius);
    color: var(--text-on-ink-muted);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
    padding: 14px var(--sp-4);
  }

  .route-text {
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
  }

  .route-channels {
    color: var(--text-on-ink-muted);
    font-weight: 400;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .route-row--after .route-node {
    border-style: solid;
    border-color: var(--green);
    color: var(--text-on-ink);
  }

  .route-row--after .route-number {
    color: var(--green-light);
  }

  .route-row--before .route-number {
    color: var(--text-on-ink-muted);
  }

  .route-row--after .route-node:last-child {
    background: var(--green);
    border-color: var(--green);
    color: var(--on-green);
  }

  .route-row--after .route-node:last-child .route-number {
    color: var(--on-green);
  }

  .route-closing {
    color: var(--text-on-ink-muted);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    margin: var(--sp-8) 0 0;
    max-width: 70%;
  }

  @media (min-width: 900px) {
    .recorrido {
      padding-block: calc(var(--sp-12) + var(--sp-2));
      padding-inline: calc(var(--sp-8) + var(--sp-2));
    }

    h2 {
      font-size: 38px;
      max-width: 60%;
    }

    .route-nodes {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .recorrido {
      padding-inline: var(--sp-16);
    }
  }
</style>
