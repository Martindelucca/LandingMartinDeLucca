---
interface Props {
  numero: string;
  recorrido: {
    titulo: string;
    fraseInstagram: string;
    puente: string;
    diagrama: {
      canales: string;
      nodos: string[];
    };
    cierre: string;
  };
}

const { numero, recorrido } = Astro.props;
---

<section class="recorrido" id="recorrido" aria-labelledby="recorrido-title">
  <p class="section-label">{numero} / {recorrido.titulo}</p>
  <h2 id="recorrido-title">{recorrido.fraseInstagram}</h2>
  <p class="route-bridge">{recorrido.puente}</p>
  <ol class="route-nodes" aria-labelledby="recorrido-title">
    {recorrido.diagrama.nodos.map((nodo, index) => (
      <li class="route-node">
        <span class="route-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="route-text">{nodo}</span>
        {index === 0 && <span class="route-channels">{recorrido.diagrama.canales}</span>}
      </li>
    ))}
  </ol>
  <p class="route-closing">{recorrido.cierre}</p>
</section>

<style>
  .recorrido {
    background: var(--ink);
    border-bottom: 1px solid var(--rule);
    color: var(--text-on-ink);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .section-label,
  .route-number,
  .route-channels {
    color: var(--green-light);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-6);
  }

  h2 {
    color: var(--text-on-ink);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0;
  }

  .route-bridge {
    color: var(--text-on-ink-muted);
    font-size: 17px;
    line-height: 1.6;
    margin: var(--sp-6) 0 var(--sp-8);
  }

  .route-nodes {
    align-items: start;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .route-node {
    border: 1px solid var(--green);
    border-radius: var(--radius);
    color: var(--text-on-ink);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
    padding: 14px var(--sp-4);
  }

  .route-text {
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
  }

  .route-channels {
    color: var(--text-on-ink-muted);
    font-weight: 400;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .route-number {
    color: var(--green-light);
  }

  .route-node:last-child {
    background: var(--green);
    border-color: var(--green);
    color: var(--on-green);
  }

  .route-node:last-child .route-number,
  .route-node:last-child .route-channels {
    color: var(--on-green);
  }

  .route-closing {
    color: var(--text-on-ink-muted);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    margin: var(--sp-8) 0 0;
  }

  @media (min-width: 900px) {
    .recorrido {
      padding-block: calc(var(--sp-12) + var(--sp-2));
      padding-inline: calc(var(--sp-8) + var(--sp-2));
    }

    h2 {
      font-size: 38px;
      max-width: 60%;
    }

    .route-nodes {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .recorrido {
      padding-inline: var(--sp-16);
    }
  }
</style>
