---
interface Props {
  numero: string;
  recorrido: {
    titulo: string;
    fraseInstagram: string;
    puente: string;
    diagrama: {
      canales: string;
      nodos: string[];
    };
    cierre: string;
  };
}

const { numero, recorrido } = Astro.props;
---

<section class="recorrido" id="recorrido" aria-labelledby="recorrido-title">
  <p class="section-label">{numero} / {recorrido.titulo}</p>
  <h2 id="recorrido-title">{recorrido.fraseInstagram}</h2>
  <p class="route-bridge">{recorrido.puente}</p>
  <ol class="route-nodes" aria-labelledby="recorrido-title">
    {recorrido.diagrama.nodos.map((nodo, index) => (
      <li class="route-node" style={`--i: ${index}`}>
        <span class="route-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="route-text">{nodo}</span>
        {index === 0 && <span class="route-channels">{recorrido.diagrama.canales}</span>}
      </li>
    ))}
  </ol>
  <p class="route-closing">{recorrido.cierre}</p>
</section>

<script>
  const initRecorridoNodes = () => {
    const nodes = document.querySelector<HTMLElement>('#recorrido .route-nodes');

    if (
      !nodes ||
      nodes.dataset.reveal !== undefined ||
      !('IntersectionObserver' in window) ||
      !('matchMedia' in window)
    ) {
      return;
    }

    nodes.dataset.reveal = '';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      nodes.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          nodes.classList.add('is-visible');
          observer.unobserve(nodes);
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
    );

    observer.observe(nodes);
  };

  initRecorridoNodes();
</script>

<style>
  .recorrido {
    background: var(--ink);
    border-bottom: 1px solid var(--rule);
    color: var(--text-on-ink);
    padding: var(--sp-section-y) var(--sp-section-x);
  }

  .section-label,
  .route-number,
  .route-channels {
    color: var(--green-light);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-section-gap);
  }

  h2 {
    color: var(--text-on-ink);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0;
  }

  .route-bridge {
    color: var(--text-on-ink-muted);
    font-size: 17px;
    line-height: 1.6;
    margin: var(--sp-6) 0 var(--sp-8);
  }

  .route-nodes {
    align-items: start;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
    Aparición escalonada de los nodos: autorizada en DESIGN_SYSTEM §10
    (80 ms entre nodos, cadena < 500 ms). Mismo patrón que el rail de Proceso:
    la clase de arranque la pone el JS, así que sin JS el diagrama está completo
    y visible (invariante 19).
  */
  @media (prefers-reduced-motion: no-preference) {
    .route-nodes[data-reveal] .route-node {
      opacity: 0;
      transform: translateY(var(--sp-3));
    }

    .route-nodes[data-reveal].is-visible .route-node {
      animation: route-node-in 400ms ease-out forwards;
      animation-delay: calc(var(--i) * 80ms);
    }

    @keyframes route-node-in {
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  .route-node {
    border: 1px solid var(--green);
    border-radius: var(--radius);
    color: var(--text-on-ink);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
    padding: 14px var(--sp-4);
  }

  .route-text {
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
  }

  .route-channels {
    color: var(--text-on-ink-muted);
    font-weight: 400;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .route-number {
    color: var(--green-light);
  }

  .route-node:last-child {
    background: var(--green);
    border-color: var(--green);
    color: var(--on-green);
  }

  .route-node:last-child .route-number,
  .route-node:last-child .route-channels {
    color: var(--on-green);
  }

  .route-closing {
    color: var(--text-on-ink-muted);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.35;
    margin: var(--sp-section-gap) 0 0;
    max-width: 46rem;
  }

  @media (min-width: 900px) {
    h2 {
      max-width: 60%;
    }

    .route-nodes {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
