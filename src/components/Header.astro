---
interface Props {
  header: {
    nombre: string;
    ctaLabel: string;
  };
  whatsapp: {
    numero: string;
    etiquetaCta: string;
    mensajes: {
      hero: string;
    };
  };
}

const { header, whatsapp } = Astro.props;
const href = `https://wa.me/${whatsapp.numero}?text=${encodeURIComponent(whatsapp.mensajes.hero)}`;
---

<header class="site-header">
  <p class="site-name">{header.nombre}</p>
  <a class="header-cta" href={href} target="_blank" rel="noopener" data-origin="header">
    <span class="header-cta-square" aria-hidden="true"></span>
    <span>{header.ctaLabel}</span>
  </a>
</header>

<style>
  .site-header {
    align-items: center;
    border-bottom: 1px solid var(--rule-hard);
    display: flex;
    justify-content: space-between;
    /* El vertical es propio del header (§3); el lateral sigue al de sección
       para que el nombre quede alineado con el contenido de abajo. */
    padding: var(--sp-4) var(--sp-section-x);
  }

  .site-name {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
  }

  .header-cta {
    align-items: center;
    background: var(--ink);
    color: var(--paper);
    display: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    gap: var(--sp-2);
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 11px var(--sp-4);
    text-decoration: none;
    text-transform: uppercase;
  }

  .header-cta-square {
    background: var(--green);
    display: block;
    height: var(--sp-2);
    width: var(--sp-2);
  }

  .header-cta:focus-visible {
    outline-color: var(--green);
  }

  .header-cta:hover {
    background: var(--ink-alt);
  }

  @media (min-width: 900px) {
    .header-cta {
      display: inline-flex;
    }
  }
</style>
