---
interface Props {
  mecanismos: {
    numero: string;
    titulo: string;
    bloques: Array<{
      numero: string;
      titulo: string;
      texto: string;
    }>;
  };
}

const { mecanismos } = Astro.props;
---

<section class="solucion" id="solucion" aria-labelledby="solucion-title">
  <h2 id="solucion-title" class="section-label">{mecanismos.numero} / {mecanismos.titulo}</h2>
  <ol class="mechanisms">
    {mecanismos.bloques.map((bloque) => (
      <li class="mechanism">
        <p class="mechanism-label">{bloque.numero} / {bloque.titulo}</p>
        <p class="mechanism-text">{bloque.texto}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .solucion {
    border-bottom: 1px solid var(--rule);
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .section-label,
  .mechanism-label {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 var(--sp-6);
  }

  .mechanisms {
    background: var(--rule);
    border: 1px solid var(--rule);
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mechanism {
    background: var(--paper);
    min-width: 0;
    padding: var(--sp-5);
  }

  .mechanism-label {
    margin: 0 0 var(--sp-4);
  }

  .mechanism-text {
    color: var(--text);
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
    max-width: 34rem;
  }

  @media (min-width: 900px) {
    .solucion {
      padding-block: calc(var(--sp-12) + var(--sp-2));
      padding-inline: calc(var(--sp-8) + var(--sp-2));
    }

    .mechanisms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mechanism {
      padding: 26px;
    }
  }

  @media (min-width: 1280px) {
    .solucion {
      padding-inline: var(--sp-16);
    }
  }
</style>
