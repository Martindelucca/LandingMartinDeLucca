---
import WhatsappButton from './ui/WhatsappButton.astro';

interface Props {
  numero: string;
  queConstruyo: {
    titulo: string;
    producto: string;
    metodo: string[];
    captura: {
      src: string;
      alt: string;
      placeholder: string;
    };
  };
  whatsapp: {
    numero: string;
    etiquetaCta: string;
    mensajes: {
      queConstruyo: string;
    };
  };
}

const { numero, queConstruyo, whatsapp } = Astro.props;
---

<section class="build-section" id="que-construyo" aria-labelledby="build-title">
  <div class="build-copy">
    <p class="section-label">{numero} / {queConstruyo.titulo}</p>
    <h2 id="build-title">{queConstruyo.producto}</h2>
    <ol class="method-list" aria-label={queConstruyo.producto}>
      {queConstruyo.metodo.map((paso, index) => (
        <li class:list={{ 'method-chip': true, 'method-chip--last': index === queConstruyo.metodo.length - 1 }}>
          {paso}
        </li>
      ))}
    </ol>
    <div class="build-cta">
      <WhatsappButton
        number={whatsapp.numero}
        message={whatsapp.mensajes.queConstruyo}
        label={whatsapp.etiquetaCta}
        origin="queConstruyo"
      />
    </div>
  </div>

  <div class="build-capture">
    <div class="phone-frame">
      {queConstruyo.captura.src ? (
        <img class="phone-screen" src={queConstruyo.captura.src} alt={queConstruyo.captura.alt} />
      ) : (
        <div class="phone-screen capture-placeholder" role="img" aria-label={queConstruyo.captura.placeholder}>
          <span>{queConstruyo.captura.placeholder}</span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .build-section {
    align-items: center;
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: calc(var(--sp-8) + var(--sp-2));
    grid-template-columns: 1fr;
    padding: calc(var(--sp-8) + var(--sp-2)) var(--sp-5);
  }

  .build-copy {
    min-width: 0;
  }

  .section-label {
    color: var(--green);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0 0 var(--sp-5);
    text-transform: uppercase;
  }

  h2 {
    color: var(--text-strong);
    font-family: 'Archivo Variable', Arial, sans-serif;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin: 0 0 18px;
  }

  .method-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
  }

  .method-chip {
    border: 1px solid var(--rule);
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.2;
    padding: 8px 10px;
    text-transform: uppercase;
  }

  .method-chip--last {
    border-color: var(--green);
    color: var(--green);
  }

  .build-cta {
    margin-top: 0;
  }

  .build-cta :global(.whatsapp-button) {
    display: inline-flex;
    gap: 12px;
    height: 56px;
    min-height: 56px;
    padding: 0 26px;
    width: auto;
  }

  .build-capture {
    display: flex;
    justify-content: center;
    order: 2;
  }

  .phone-frame {
    align-items: flex-end;
    aspect-ratio: 9 / 17;
    background: var(--panel);
    border: 1px solid var(--ink);
    display: flex;
    justify-content: center;
    max-width: 240px;
    padding: var(--sp-3);
    width: 100%;
  }

  .phone-screen {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .capture-placeholder {
    align-items: flex-end;
    background-image: repeating-linear-gradient(
      135deg,
      rgba(14, 18, 17, 0.06) 0 6px,
      transparent 6px 12px
    );
    color: var(--text);
    display: flex;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    justify-content: center;
    line-height: 1.2;
    padding: 0;
    text-align: center;
  }

  @media (max-width: 899px) {
    .build-cta :global(.whatsapp-button) {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .build-section {
      grid-template-columns: minmax(0, 1fr) 240px;
      padding: calc(var(--sp-12) + var(--sp-2)) calc(var(--sp-8) + var(--sp-2));
    }

    .build-capture {
      order: 0;
    }
  }

  @media (min-width: 1280px) {
    .build-section {
      padding-inline: var(--sp-16);
    }
  }
</style>
